# Gemini (attribution judge)
GEMINI_API_KEY=
GEMINI_MODEL=
# Postgres URL in production; leave empty locally to use PGlite in .data/
DATABASE_URL=
# GitHub token for finding who maintains a repo (read-only, public repos). Optional: without it GitHub allows
# 60 requests an hour. A token GitHub refuses stops the settlement with a clear error.
GITHUB_TOKEN=
# GitHub OAuth app for maintainer sign-in (github.com/settings/developers). Its callback is
# <PUBLIC_URL>/maintainer/github/callback. Separate from GITHUB_TOKEN above.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PayPal sandbox app. In its Log in with PayPal settings: return URL <PUBLIC_URL>/maintainer/paypal/callback, and the
# "PayPal account ID" and "Account verification status" attributes turned on (maintainers can't link without them).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Defaults to the sandbox API
PAYPAL_API_BASE=
# From the dashboard's Webhooks page, once the hosted URL is registered. Without it /api/paypal/webhook answers 503.
PAYPAL_WEBHOOK_ID=
# Written by `pnpm --filter web paypal:setup --write`
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_BUILDER=
PAYPAL_PLAN_TEAM=
# Browser-side PayPal buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_ENV=sandbox
# Public address of this server, for the login links the CLI prints (defaults to the request's own address)
PUBLIC_URL=
# Lets POST /api/settle run a settlement ("Settle now"). Leave empty to switch that endpoint off.
SETTLE_TOKEN=
# 1 turns on the hosted sandbox demo: "Try the demo" accounts, "Run a sample session" and "Settle now" for them.
DEMO_MODE=
# Pay a maintainer once they are owed this many cents. Leave empty for $1; the hosted sandbox demo uses 1.
MIN_PAYOUT_CENTS=
